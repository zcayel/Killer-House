{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy --target-content https://worlds-content-server.decentraland.org",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "server-logs": "sdk-commands sdk-server-logs",
    "verify": "tsc --noEmit -p tsconfig.json",
    "scores": "sdk-commands storage scene get killer_house_leaderboard_v1",
    "scores:local": "sdk-commands storage scene get killer_house_leaderboard_v1 --target http://localhost:8000"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.26.1-32860802198.commit-dae48fb",
    "@dcl/sdk": "7.26.1-32860802198.commit-dae48fb"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}