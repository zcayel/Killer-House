# Build tooling and source assets. None of this is referenced at runtime —
# every mention lives in src/config.ts comments, which never ship.
#
# Shipping the .py files is what broke deploys: the worlds content server
# sits behind Cloudflare, whose managed rules reject multipart uploads
# containing script source, and the deploy comes back as a
# "Sorry, you have been blocked" HTML page instead of a real error.
tools
forcefield-source
lightning-source
smoke-source
title-source
wood-source
*.py
**/*.py
*.pyc
**/*.pyc
__pycache__
LICENSE
*.bak_wrong
*.bak_wrong_grip
*.bak
